# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Ingestion Webhook / Secret Key (Used by Raspberry Pi gateway)
GATEWAY_INGESTION_SECRET=your-secure-gateway-secret-token

# Default Estate Context
NEXT_PUBLIC_DEFAULT_FACTORY_ID=22222222-2222-2222-2222-222222222222

